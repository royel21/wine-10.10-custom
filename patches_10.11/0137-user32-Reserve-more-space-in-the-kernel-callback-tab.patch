From 167a9d5c324dfd1d0e485573ab818fd565c73b65 Mon Sep 17 00:00:00 2001
From: Paul Gofman <pgofman@codeweavers.com>
Date: Wed, 18 Jun 2025 19:28:18 -0600
Subject: [PATCH 137/293] user32: Reserve more space in the kernel callback
 table.

---
 dlls/wow64win/user.c | 4 +---
 include/ntuser.h     | 2 +-
 2 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/dlls/wow64win/user.c b/dlls/wow64win/user.c
index a218de8b24f..594085e3777 100644
--- a/dlls/wow64win/user.c
+++ b/dlls/wow64win/user.c
@@ -1505,15 +1505,13 @@ static NTSTATUS WINAPI wow64_NtUserDragDropPost( void *arg, ULONG size )
     return dispatch_callback( NtUserDragDropPost, params32, size );
 }
 
-ntuser_callback user_callbacks[] =
+ntuser_callback user_callbacks[NtUserCallCount] =
 {
 #define USER32_CALLBACK_ENTRY(name) wow64_NtUser##name,
     ALL_USER32_CALLBACKS
 #undef USER32_CALLBACK_ENTRY
 };
 
-C_ASSERT( ARRAYSIZE(user_callbacks) == NtUserCallCount );
-
 NTSTATUS WINAPI wow64_NtUserActivateKeyboardLayout( UINT *args )
 {
     HKL layout = get_handle( &args );
diff --git a/include/ntuser.h b/include/ntuser.h
index 12f51493f9b..8e539bb1d69 100644
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -102,7 +102,7 @@ enum
 #define USER32_CALLBACK_ENTRY(name) NtUser##name,
     ALL_USER32_CALLBACKS
 #undef USER32_CALLBACK_ENTRY
-    NtUserCallCount
+    NtUserCallCount = 256
 };
 
 /* NtUserCallDispatchCallback params */
-- 
2.43.0

