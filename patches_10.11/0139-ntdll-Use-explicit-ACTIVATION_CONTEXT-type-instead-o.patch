             len = sizeof(*acrli);
             if (retlen) *retlen = len;
@@ -5894,11 +5889,10 @@ NTSTATUS WINAPI RtlFindActivationContextSectionGuid( ULONG flags, const GUID *ex
 /***********************************************************************
